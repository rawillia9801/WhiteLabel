# Branding (safe to expose in the browser)
NEXT_PUBLIC_BRAND_NAME=Your Breeder OS
NEXT_PUBLIC_BRAND_SHORT_NAME=BREEDER OS
NEXT_PUBLIC_BRAND_TAGLINE=Thoughtful breeding. Organized beautifully.
NEXT_PUBLIC_BRAND_DESCRIPTION=A complete operating system for responsible dog breeders.
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_FAVICON_URL=/favicon.svg
NEXT_PUBLIC_BRAND_SOCIAL_IMAGE_URL=/og.png
NEXT_PUBLIC_BREEDER_EMAIL=hello@example.com
NEXT_PUBLIC_BREEDER_PHONE=+1 555 123 4567
NEXT_PUBLIC_BREEDER_WEBSITE=https://example.com
NEXT_PUBLIC_BREEDER_LOCATION=Your City, State

# Theme
NEXT_PUBLIC_COLOR_PRIMARY=#087f8c
NEXT_PUBLIC_COLOR_PRIMARY_DARK=#155f69
NEXT_PUBLIC_COLOR_ACCENT=#c68b24
NEXT_PUBLIC_COLOR_BACKGROUND=#f3f7f6
NEXT_PUBLIC_COLOR_SURFACE=#ffffff
NEXT_PUBLIC_COLOR_TEXT=#173941
NEXT_PUBLIC_COLOR_MUTED_TEXT=#627b7e
NEXT_PUBLIC_COLOR_BORDER=#c8d8d5
NEXT_PUBLIC_BORDER_RADIUS=14px

# Locale and business rules (prices are decimal currency amounts, not cents)
NEXT_PUBLIC_LANGUAGE=en
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_CURRENCY=USD
BREEDER_TIMEZONE=America/New_York
BREEDER_LEGAL_NAME=Your Breeding Business LLC
BREEDER_DEFAULT_PUPPY_PRICE=0
BREEDER_DEFAULT_DEPOSIT=0
BREEDER_DELIVERY_FEE=0
BREEDER_SPECIAL_CARE_FEE=0
BREEDER_POLICY_JURISDICTION=Your state or province
BREEDER_HEALTH_EXAM_HOURS=72
BREEDER_HEALTH_GUARANTEE_MONTHS=12
BREEDER_DEPOSIT_REFUNDABLE=false
BREEDER_CUSTOM_POLICY_NOTICE=Have a qualified local attorney review all customer-facing policies and contracts before use.

# Optional modules
NEXT_PUBLIC_FEATURE_PHONE_CENTER=false
NEXT_PUBLIC_FEATURE_TRANSPORTATION=false
NEXT_PUBLIC_FEATURE_FAMILY_PORTAL=true
NEXT_PUBLIC_FEATURE_APPLICATIONS=true

# Each breeder must use an isolated database and unique secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents
ADMIN_PASSWORD=replace-with-a-long-random-password
SWVAOS_CRM_API_KEY=replace-with-a-long-random-key
SWVAOS_PORTAL_SECRET=replace-with-a-different-long-random-key
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://your-domain.example
TWILIO_SKIP_SIGNATURE_VALIDATION=false
